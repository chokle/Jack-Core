# Cloudflare deploy/build input. Publishable Clerk keys are browser-visible; never put secret keys here.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Set these with `wrangler secret put <NAME> --config cloudflare/wrangler.generated.json`.
CLERK_SECRET_KEY=sk_live_...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_DB_URL=postgresql://...
OPENAI_API_KEY=sk-...
RESEND_API_KEY=re_...

# Runtime configuration. These can be Worker vars instead of secrets where appropriate.
ADMIN_EMAILS=admin@example.com
FEEDBACK_FROM_EMAIL=Jack Feedback <feedback@your-verified-domain.example>
FEEDBACK_NOTIFICATION_RECIPIENTS=derek@torchlabs.ca

# Pilot001 scope IDs are already defined in cloudflare/wrangler.base.json.
# PILOT_001_ID=394314ad-782b-4683-bc5d-65a0a3ba2552
# PILOT_001_ORGANIZATION_ID=40817dd6-d2b8-4087-a6f2-f416500ab4e6
