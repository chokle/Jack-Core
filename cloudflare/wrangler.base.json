{
  "name": "jack-core-production",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "8080",
    "BASE_PATH": "/",
    "PUBLIC_SITE_URL": "https://jack.torchlabs.ca",
    "CORS_ALLOWED_ORIGINS": "https://jack.torchlabs.ca",
    "PILOT_001_ID": "394314ad-782b-4683-bc5d-65a0a3ba2552",
    "PILOT_001_ORGANIZATION_ID": "40817dd6-d2b8-4087-a6f2-f416500ab4e6",
    "PILOT_AUTH_BYPASS": "false"
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "SUPABASE_DB_URL",
      "CLERK_SECRET_KEY",
      "OPENAI_API_KEY",
      "RESEND_API_KEY",
      "ADMIN_EMAILS",
      "FEEDBACK_FROM_EMAIL",
      "FEEDBACK_NOTIFICATION_RECIPIENTS"
    ]
  },
  "containers": [
    {
      "class_name": "JackProductionContainer",
      "name": "jack-core-production",
      "image": "../Dockerfile.cloudflare",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1,
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "JACK_CONTAINER",
        "class_name": "JackProductionContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JackProductionContainer"]
    }
  ]
}
