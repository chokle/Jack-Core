{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jack-runtime-persistence-foundation",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 50 },
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "TASK_STATE", "class_name": "RuntimeTaskState" }] },
  "migrations": [{ "tag": "v1-runtime-sqlite", "new_sqlite_classes": ["RuntimeTaskState"] }],
  "workflows": [{ "binding": "RECOVERY_WORKFLOW", "name": "jack-runtime-recovery", "class_name": "RecoveryWorkflow" }],
  "queues": {
    "producers": [{ "binding": "REPORT_QUEUE", "queue": "jack-runtime-reporting" }],
    "consumers": [{ "queue": "jack-runtime-reporting", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 2, "dead_letter_queue": "jack-runtime-reporting-dead-letter" }]
  },
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "jack-runtime-artifacts-private" }],
  "d1_databases": [{ "binding": "REPORTING_DB", "database_name": "jack-runtime-operational-reporting", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "FOUNDATION_STAGE": "unprovisioned", "AI_GATEWAY_ID": "jack-runtime-control" }
}
