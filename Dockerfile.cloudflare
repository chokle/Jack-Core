# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app

RUN corepack enable

COPY . .
RUN pnpm install --frozen-lockfile

ARG BASE_PATH=/
ARG PUBLIC_SITE_URL=https://jack.torchlabs.ca
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_PILOT_AUTH_BYPASS=true
ARG VITE_DISABLE_CLERK_PROXY=true
ARG VITE_ENABLE_CLERK_PROXY=false

ENV BASE_PATH=$BASE_PATH
ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_PILOT_AUTH_BYPASS=$VITE_PILOT_AUTH_BYPASS
ENV VITE_DISABLE_CLERK_PROXY=$VITE_DISABLE_CLERK_PROXY
ENV VITE_ENABLE_CLERK_PROXY=$VITE_ENABLE_CLERK_PROXY

RUN pnpm --filter ./artifacts/jack-core build \
  && pnpm --filter ./artifacts/api-server build

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

CMD ["node", "--enable-source-maps", "./artifacts/api-server/dist/index.mjs"]
