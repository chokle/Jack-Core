{
  "name": "@workspace/jack-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.x"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/core/*.test.ts",
    "export:android": "expo export --platform android --output-dir dist-android",
    "prebuild:android": "expo prebuild --platform android --no-install"
  },
  "dependencies": {
    "@clerk/clerk-expo": "2.20.1",
    "@react-native-community/netinfo": "11.5.2",
    "expo": "55.0.31",
    "expo-audio": "55.0.18",
    "expo-auth-session": "55.0.18",
    "expo-crypto": "55.0.19",
    "expo-file-system": "55.0.26",
    "expo-secure-store": "55.0.18",
    "expo-status-bar": "55.0.6",
    "expo-video": "55.0.21",
    "expo-web-browser": "55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "25.3.3",
    "@types/react": "19.2.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
