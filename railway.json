{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "PORT=4173 BASE_PATH=/ PUBLIC_SITE_URL=https://jack.torchlabs.ca VITE_ENABLE_CLERK_PROXY=false pnpm --filter ./artifacts/jack-core build && pnpm --filter ./artifacts/api-server build",
    "watchPatterns": [
      "/artifacts/jack-core/**",
      "/artifacts/api-server/**",
      "/lib/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "PILOT_001_ID=394314ad-782b-4683-bc5d-65a0a3ba2552 PILOT_001_ORGANIZATION_ID=40817dd6-d2b8-4087-a6f2-f416500ab4e6 pnpm --filter ./artifacts/api-server run seed:knowledge",
    "preDeployTimeoutSeconds": 600,
    "startCommand": "pnpm --filter ./artifacts/api-server start",
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
